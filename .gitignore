# Secrets — never commit
.env
.env.*

# ETS project exports and vendor product data are copyrighted / contain personal data
*.knxproj
*.knxprod
bussard-initial.md

# Product-corpus download cache: vendor .knxprod files (already covered by the
# *.knxprod rule above) plus the models/*.yaml derived from them. Ignore the whole
# cache dir so nothing downloaded or generated under it is ever committed.
tests-support/product-corpus/cache*/

# Second, separate corpus of vendor product files found by crawling (see
# tests-support/product-corpus-extra/README.md). Same rule: the whole cache
# dir is git-ignored, only the pointer index is committed.
tests-support/product-corpus-extra/cache*/

# Local KNX installation data (the user's personal model at the repo root).
# Anchored to the root so it does not swallow committed example models such as
# knx-sim/examples/small-installation/knx/.
/knx/
captures/
*.db

# Rust
target/

# xknxproject oracle dumps (derived from the private .knxproj)
fixtures/private/

# Parallels/VM share for exe round-trips — never commit binaries
shared-with-windows/

# Session scratch + vendor-derived analysis dumps (never commit)
/scratchpad/

# Python bytecode
__pycache__/
*.pyc

# website build output (see website/README.md)
_site/
website/site/

# The TOML conversion of the private house model (phase 1 of the TOML switch).
/knx-toml/

# The product-model JSON cache (#339) the tests write next to fixture models.
**/.bussard/model-cache/
knx-sim/target-win/
tools/ets-sweep/.unpacked/

# external specification
dev/knx-standard-3.0.0/